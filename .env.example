# Copy to .env for local development. NEVER commit real values.
# Production/staging values are set as Railway variables (see docs/08-operations/railway-deployment.md).

APP_ENV=development
PORT=3000

# --- Database -------------------------------------------------------------
# Local development without installing PostgreSQL: embedded PGlite stored in this folder.
PGLITE_DIR=./.pglite/dev
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}   (owner/migrator connection)
# DATABASE_URL=
# Runtime least-privilege role password (required on Railway; 24+ random characters).
# DB_APP_PASSWORD=

# --- Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1

# --- HTTP ------------------------------------------------------------------
COOKIE_SECURE=false
# Railway = 2 (internal proxy + edge; Railway replaces client-sent X-Forwarded-For, DL-035)
TRUST_PROXY=0

# --- First administrator (first deploy only; remove the password afterwards) ---
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_GROUP_NAME_AR=
# BOOTSTRAP_GROUP_NAME_EN=

# --- Off-site backups (Backblaze B2, EU region) ------------------------------
# BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# BACKUP_S3_REGION=eu-central-003
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEY_ID=b1
